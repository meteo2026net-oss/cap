PORT=8095
HOST=127.0.0.1
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARS
CAP_SENDER=alerts@example.org
CAP_SENDER_NAME=National Meteorological Service
PUBLIC_BASE_URL=http://localhost:8095
CORS_ORIGINS=http://localhost:8095

# Optional SQLite database path; default: storage/cap.sqlite (Docker: /app/storage/cap.sqlite).
# DB_PATH=/absolute/path/to/cap.sqlite

# Docker Compose host port (loopback only by default).
CAP_PORT=8095

# Optional internal queue maintenance worker polling interval (5s-5m).
CAP_DELIVERY_WORKER_INTERVAL_MS=30000

# MFA encryption key: generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))".
# Keep this key stable and private; losing it makes enrolled MFA secrets unrecoverable.
# MFA_ENCRYPTION_KEY=64_HEX_CHARACTERS_FROM_RANDOM_BYTES

# Optional signed inbound webhook inbox (disabled unless explicitly enabled).
CAP_WEBHOOK_INGRESS_ENABLED=false
CAP_WEBHOOK_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
