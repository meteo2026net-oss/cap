{
  "name": "meteo-cap-warning-system",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Common Alerting Protocol 1.2 warning management system",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:cap-schema": "node --test tests/cap-schema.test.js",
    "perf:10k": "node tests/perf/run-10k.mjs",
    "backup": "node src/backup.js",
    "restore": "node src/restore.js",
    "setup:local": "node scripts/setup-local.mjs",
    "worker": "node src/delivery-worker.js",
    "backup:verify": "node src/verify-backup.js",
    "backup:list": "node src/list-backups.js",
    "backup:health": "node src/backup-health.js",
    "restore:verify": "node src/verify-restored-db.js",
    "restore:drill": "node src/restore-drill.js",
    "audit:checkpoint:init": "node scripts/initialize-audit-checkpoint.js",
    "audit:checkpoint:refresh": "node scripts/refresh-audit-checkpoint.js",
    "retention:apply": "node src/apply-retention.js",
    "ops:metrics": "node -e \"import('./src/db.js').then(async m=>{const {collectOperationalMetrics}=await import('./src/retention.js'); console.log(JSON.stringify(collectOperationalMetrics(m.db),null,2)); m.db.close();})\"",
    "acceptance:bootstrap-tenants": "node scripts/bootstrap-acceptance-tenants.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  }
}
